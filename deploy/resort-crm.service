# ทางเลือก: deploy แบบไม่ใช้ Docker (systemd + venv)
# คัดลอกไปที่ /etc/systemd/system/resort-crm.service
# แล้ว: sudo systemctl daemon-reload && sudo systemctl enable --now resort-crm

[Unit]
Description=Resort CRM (Gunicorn)
After=network.target postgresql.service

[Service]
User=resort
Group=www-data
WorkingDirectory=/srv/resort-crm
EnvironmentFile=/srv/resort-crm/.env
Environment=GUNICORN_BIND=127.0.0.1:8000
ExecStart=/srv/resort-crm/.venv/bin/gunicorn config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
