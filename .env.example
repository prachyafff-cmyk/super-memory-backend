# คัดลอกเป็น .env แล้วแก้ค่า:  cp .env.example .env
# ห้าม commit ไฟล์ .env ขึ้น Git

# --- Django ---
# สร้าง key:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=crm.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com
# Nginx + Certbot redirect HTTP→HTTPS ให้แล้ว จึงปล่อย False ได้
DJANGO_SECURE_SSL_REDIRECT=False
# ตั้ง False ชั่วคราวเฉพาะตอนทดสอบผ่าน http:// (ก่อนติด SSL) ไม่งั้นจะ login ไม่ได้
DJANGO_SECURE_COOKIES=True
# เปิด HSTS หลังมั่นใจว่า HTTPS ใช้งานได้ดีแล้ว เช่น 31536000 (1 ปี)
DJANGO_SECURE_HSTS_SECONDS=0
RESORT_NAME=Seaside Resort

# --- PostgreSQL (ใช้กับ docker-compose) ---
# ใช้รหัสที่ไม่มีอักขระพิเศษ เพราะจะถูกใส่ใน URL:  openssl rand -hex 24
POSTGRES_DB=resort_crm
POSTGRES_USER=resort
POSTGRES_PASSWORD=

# ถ้าไม่ใช้ Docker ให้ตั้ง DATABASE_URL เอง (ไม่ตั้ง = ใช้ SQLite)
# DATABASE_URL=postgres://resort:PASSWORD@127.0.0.1:5432/resort_crm

# --- Superuser ครั้งแรก (entrypoint.sh สร้างให้อัตโนมัติ) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# --- Gunicorn ---
GUNICORN_WORKERS=3
